# Infisical project IDs (if using Infisical for secrets)
LLM_SHARED_PROJECT_ID=
LLM_DISCOVERY_PROJECT_ID=

# Secrets can be provided either via Infisical (recommended) or plain env vars.
# LLM_SHARED_PROJECT_ID holds all provider keys + judge key (AGNES_AI_API_KEY, GROQ_API_KEY, KILO_AI_API_KEY, etc.)
# LLM_DISCOVERY_PROJECT_ID holds only AA_API_KEY for catalog refresh
# Alternatively, export keys directly: export GROQ_API_KEY=... AGNES_AI_API_KEY=...

# Web search backends (all OPTIONAL):
# BRAVE_API_KEY — Brave Search API ($5 free credits / month). Higher quality.
# If absent, DuckDuckGo (no key) is used automatically.
# DISABLE_WEB_SEARCH=1 — forces NoopSearcher (offline mode).
