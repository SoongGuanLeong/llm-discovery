#!/bin/sh
# PROTOTYPE (#270) shim so the literal `llm-discovery` command name is exercised.
#
# Not a packaging entry point. #271 adds the real one to pyproject.toml:
#
#     [project.scripts]
#     llm-discovery = "llm_discovery.cli:main"
#
# Try the prototype without installing anything:
#
#     export PATH="$PWD/prototypes/issue270:$PATH"
#     llm-discovery doctor
#
# Prefers the repo venv so the prototype runs against the real dependencies.
set -e
here=$(cd "$(dirname "$0")" && pwd)
repo=$(cd "$here/../.." && pwd)
if [ -x "$repo/.venv/bin/python" ]; then
    exec "$repo/.venv/bin/python" "$here/llm_discovery_cli.py" "$@"
fi
exec python3 "$here/llm_discovery_cli.py" "$@"
