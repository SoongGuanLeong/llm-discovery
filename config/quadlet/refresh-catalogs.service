[Unit]
Description=Refresh LLM catalogs (AA + models.dev + benchmarks) - user service
Documentation=file:README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Paths materialized at install time (repo root + venv python).
WorkingDirectory={{REPO_ROOT}}
ExecStart={{VENV_PYTHON}} -m llm_discovery refresh
# AA API key file, written from Infisical (0600, '-': optional).
# models.dev refresh needs no key; AA degrades to a logged error when absent.
EnvironmentFile=-{{AA_KEY_FILE}}
