[Volume]
# Bifrost data bind-mount volume for file-only config persistence
# Bind-mounts the project's data/bifrost directory to /app/data in container
# NOTE: Source is a placeholder - scripts/setup.sh materializes the absolute
# path `$(pwd)/data/bifrost` on install via `sed "s|Source=.*|Source=$DATA_BIFROST_DIR|"`
# Do not hard-code a personal absolute path here.
Type=bind
Source=./data/bifrost.placeholder-will-be-replaced-by-setup.sh
Destination=/app/data
# SELinux label :Z ensures proper labeling for container access
Options=Z

[Install]
WantedBy=default.target
